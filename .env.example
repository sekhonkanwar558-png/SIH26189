# Copy to .env and fill in. .env is gitignored from the first commit.
#
# The key is personal, not the project's. Never paste it into README.md, a
# source file, a log line, an error message, or a chat. If it is ever committed
# it must be REVOKED in the Anthropic console, not just deleted from the file.

ANTHROPIC_API_KEY=

# Optional overrides.
ANTHROPIC_MODEL=claude-sonnet-5
# SIH_EFFORT=high                 # low | medium | high | xhigh | max
# SIH_MAX_TOOL_ITERATIONS=14      # cap on the agent's tool loop, bounds cost
# SIH_CONVERSATION_TURNS=24       # how much thread the model sees
# SIH_BETWEENNESS_EXACT_MAX=500   # above this, betweenness is estimated
# SIH_BETWEENNESS_PIVOTS=128      # sampled pivots when it is
# SIH_CASES_ROOT=                 # defaults to ./data/cases

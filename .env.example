# Copy to .env and fill in. .env is gitignored from the first commit (README §8).
#
# The key belongs to Gurpartap personally. It is not the project's key and it is
# not yours. Never paste it into README.md, a source file, a log line, an error
# message, or a chat. If it is ever committed it must be REVOKED in the
# Anthropic console, not just deleted from the file.

ANTHROPIC_API_KEY=

# Optional overrides.
ANTHROPIC_MODEL=claude-sonnet-5
# SIH_EFFORT=high                 # low | medium | high | xhigh | max
# SIH_MAX_TOOL_ITERATIONS=14      # cap on the agent's tool loop, bounds cost
# SIH_CASES_ROOT=                 # defaults to ./data/cases
